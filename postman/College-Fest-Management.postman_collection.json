{
  "info": {
    "name": "College Fest & Hackathon Management System",
    "description": "REST API collection for testing the College Fest Management System backend. Set the {{baseUrl}} variable to http://localhost:8080 (default).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "eventId", "value": "1", "type": "string" },
    { "key": "teamId", "value": "1", "type": "string" },
    { "key": "participantId", "value": "1", "type": "string" },
    { "key": "judgeId", "value": "1", "type": "string" },
    { "key": "scoreId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Get Event By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}"] }
          }
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CodeStorm Hackathon\",\n  \"description\": \"24-hour coding hackathon\",\n  \"venue\": \"Main Auditorium\",\n  \"category\": \"Hackathon\",\n  \"startTime\": \"2026-08-10T09:00:00\",\n  \"endTime\": \"2026-08-11T09:00:00\",\n  \"maxTeamSize\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Create Event (Venue Conflict Example - should fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Overlapping Event\",\n  \"description\": \"Should trigger a venue conflict\",\n  \"venue\": \"Main Auditorium\",\n  \"category\": \"Hackathon\",\n  \"startTime\": \"2026-08-10T12:00:00\",\n  \"endTime\": \"2026-08-10T18:00:00\",\n  \"maxTeamSize\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"CodeStorm Hackathon (Updated)\",\n  \"description\": \"24-hour coding hackathon - updated\",\n  \"venue\": \"Main Auditorium\",\n  \"category\": \"Hackathon\",\n  \"startTime\": \"2026-08-10T09:00:00\",\n  \"endTime\": \"2026-08-11T09:00:00\",\n  \"maxTeamSize\": 4\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}"] }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}"] }
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "Get All Teams",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/teams", "host": ["{{baseUrl}}"], "path": ["api", "teams"] }
          }
        },
        {
          "name": "Get Team By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/teams/{{teamId}}", "host": ["{{baseUrl}}"], "path": ["api", "teams", "{{teamId}}"] }
          }
        },
        {
          "name": "Register Team",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamName\": \"Byte Busters\",\n  \"leaderName\": \"Rohan Mehta\",\n  \"leaderEmail\": \"rohan.mehta@example.edu\",\n  \"leaderPhone\": \"9998887771\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/teams?eventId={{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teams"],
              "query": [{ "key": "eventId", "value": "{{eventId}}" }]
            }
          }
        },
        {
          "name": "Update Team",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamName\": \"Byte Busters\",\n  \"leaderName\": \"Rohan Mehta\",\n  \"leaderEmail\": \"rohan.mehta@example.edu\",\n  \"leaderPhone\": \"9998887771\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/teams/{{teamId}}", "host": ["{{baseUrl}}"], "path": ["api", "teams", "{{teamId}}"] }
          }
        },
        {
          "name": "Delete Team",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/teams/{{teamId}}", "host": ["{{baseUrl}}"], "path": ["api", "teams", "{{teamId}}"] }
          }
        }
      ]
    },
    {
      "name": "Participants",
      "item": [
        {
          "name": "Get All Participants",
          "request": {
