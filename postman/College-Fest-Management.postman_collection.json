          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["api", "participants", "{{participantId}}"] }
          }
        },
        {
          "name": "Add Participant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aditi Rao\",\n  \"email\": \"aditi.rao@example.edu\",\n  \"phone\": \"9998887701\",\n  \"college\": \"ABC College of Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/participants?teamId={{teamId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "participants"],
              "query": [{ "key": "teamId", "value": "{{teamId}}" }]
            }
          }
        },
        {
          "name": "Update Participant",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aditi Rao\",\n  \"email\": \"aditi.rao@example.edu\",\n  \"phone\": \"9998887701\",\n  \"college\": \"ABC College of Engineering\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["api", "participants", "{{participantId}}"] }
          }
        },
        {
          "name": "Delete Participant",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/participants/{{participantId}}", "host": ["{{baseUrl}}"], "path": ["api", "participants", "{{participantId}}"] }
          }
        }
      ]
    },
    {
      "name": "Judges",
      "item": [
        {
          "name": "Get All Judges",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/judges", "host": ["{{baseUrl}}"], "path": ["api", "judges"] }
          }
        },
        {
          "name": "Get Judge By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/judges/{{judgeId}}", "host": ["{{baseUrl}}"], "path": ["api", "judges", "{{judgeId}}"] }
          }
        },
        {
          "name": "Create Judge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Anjali Deshmukh\",\n  \"email\": \"anjali.deshmukh@example.edu\",\n  \"phone\": \"9876543210\",\n  \"expertise\": \"AI/ML\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/judges", "host": ["{{baseUrl}}"], "path": ["api", "judges"] }
          }
        },
        {
          "name": "Update Judge",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Anjali Deshmukh\",\n  \"email\": \"anjali.deshmukh@example.edu\",\n  \"phone\": \"9876543210\",\n  \"expertise\": \"AI/ML & Data Science\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/judges/{{judgeId}}", "host": ["{{baseUrl}}"], "path": ["api", "judges", "{{judgeId}}"] }
          }
        },
        {
          "name": "Delete Judge",
          "request": {
