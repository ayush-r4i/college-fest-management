      ]
    },
    {
      "name": "Scores",
      "item": [
        {
          "name": "Get All Scores",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/scores", "host": ["{{baseUrl}}"], "path": ["api", "scores"] }
          }
        },
        {
          "name": "Get Score By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/scores/{{scoreId}}", "host": ["{{baseUrl}}"], "path": ["api", "scores", "{{scoreId}}"] }
          }
        },
        {
          "name": "Submit Score (create or update)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"innovation\": 8.5,\n  \"technicalImplementation\": 8.0,\n  \"presentation\": 7.5,\n  \"uiUx\": 8.0,\n  \"overallImpression\": 8.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/scores?teamId={{teamId}}&judgeId={{judgeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scores"],
              "query": [
                { "key": "teamId", "value": "{{teamId}}" },
                { "key": "judgeId", "value": "{{judgeId}}" }
              ]
            }
          }
        },
        {
          "name": "Submit Score (Invalid - out of range, should fail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"innovation\": 15,\n  \"technicalImplementation\": 8.0,\n  \"presentation\": 7.5,\n  \"uiUx\": 8.0,\n  \"overallImpression\": 8.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/scores?teamId={{teamId}}&judgeId={{judgeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "scores"],
              "query": [
                { "key": "teamId", "value": "{{teamId}}" },
                { "key": "judgeId", "value": "{{judgeId}}" }
              ]
            }
          }
        },
        {
          "name": "Delete Score",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/scores/{{scoreId}}", "host": ["{{baseUrl}}"], "path": ["api", "scores", "{{scoreId}}"] }
          }
        }
      ]
    },
    {
      "name": "Leaderboard",
      "item": [
        {
          "name": "Get Leaderboard",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/leaderboard", "host": ["{{baseUrl}}"], "path": ["api", "leaderboard"] }
          }
        }
      ]
    }
  ]
}
